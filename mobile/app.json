{
  "expo": {
    "name": "Tucker & Spice",
    "slug": "tucker-spice",
    "scheme": "tuckerspice",
    "version": "0.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FCC13F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.patricknasr.tuckerspice"
    },
    "android": {
      "package": "com.patricknasr.tuckerspice",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FCC13F"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK"
      ],
      "versionCode": 55,
      "allowBackup": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/tucker-spice"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
