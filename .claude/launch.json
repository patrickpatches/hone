{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "expo-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "expo"],
      "port": 8081
    },
    {
      "name": "expo-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "expo-web"],
      "port": 8081
    },
    {
      "name": "bug-lord-worker",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "worker"],
      "port": 8787
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8910", "--directory", "docs/dashboard"],
      "port": 8910
    }
  ]
}
